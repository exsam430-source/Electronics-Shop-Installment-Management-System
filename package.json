{
  "name": "electronics-shop-manager",
  "version": "1.0.0",
  "description": "Electronics Shop & Installment Management System",
  "main": "main.js",
  "scripts": {
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "vite build",
    "start": "node server/index.js",
    "electron:dev": "concurrently \"npm run dev:server\" \"npm run dev:client\" \"wait-on http://localhost:5173 && electron .\"",
    "electron": "electron .",
    "pack": "electron-builder --dir",
    "dist": "npm run build:client && electron-builder"
  },
  "keywords": [
    "electronics",
    "pos",
    "installment",
    "management",
    "electron",
    "mern"
  ],
  "author": "MR SOLVER Learning Hub & Software House",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.475.0",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.2.5",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "vite": "^6.4.4",
    "wait-on": "^8.0.5"
  }
}
